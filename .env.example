# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://recongrid:recongrid@localhost:5432/recongrid

# --- Job Queue ---
REDIS_URL=redis://localhost:6379/0

# --- App Config ---
ENV=development
MAX_CSV_UPLOAD_MB=10
RECONCILIATION_TOLERANCE_INR=1.00
FUZZY_MATCH_CONFIDENCE_THRESHOLD=0.90
RAZORPAY_FETCH_MAX_RETRIES=5

# --- Settlement Q&A Agent (LLM narration only, never computation) ---
# Supported providers: "nvidia", "openai", "anthropic"
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Feature Flags ---
IS_TEST_MODE=true

