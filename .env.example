# ==============================================================================
# ReconGrid-AI — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# Application Environment (development | production | testing)
ENV=development
DEBUG_ERRORS=false
IS_TEST_MODE=true

# Allowed CORS Origins (comma-separated or JSON list)
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection URL
# SQLite default: sqlite+aiosqlite:///./recongrid.db
# PostgreSQL: postgresql+asyncpg://recongrid:recongrid@localhost:5432/recongrid
DATABASE_URL=sqlite+aiosqlite:///./recongrid.db

# Redis Cache / Job Queue URL
REDIS_URL=redis://localhost:6379/0

# Razorpay API Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Settlement Q&A Agent (LLM Configuration)
# Providers: "nvidia", "openai", "anthropic"
LLM_PROVIDER=nvidia
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# OCR / Vision Configuration (Optional for scanned PDF bank statements)
# Providers: "gemini", "openai", "ocr_space"
OCR_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Reconciliation Engine Rules & Thresholds
MAX_CSV_UPLOAD_MB=10
MAX_CSV_ROWS=50000
RECONCILIATION_TOLERANCE_INR=1.00
FUZZY_MATCH_CONFIDENCE_THRESHOLD=0.90
RAZORPAY_FETCH_MAX_RETRIES=5
GST_RATE=0.18
SETTLEMENT_PENDING_WINDOW_DAYS=5
