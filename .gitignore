# =========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# AI Assistant & Tool Caches
.claude/
.claude-omniroute/
.cursor/
.windsurf/
.aider*

# =========================
