# =====================================================================
# ReconGrid-AI — Professional .gitignore
# Stack: Python (FastAPI) + Node.js (Next.js/React/Tailwind) + SQLite/Redis
# =====================================================================

# =========================
#  Environment & Secrets
# =========================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
*.env
*.pem
*.key
*.cert
*.p12
*.crt
*.pfx
secrets/

# Keep onboarding templates
!.env.example

# =========================
#  Operating System Artifacts
# =========================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.exe
cloudflared.exe

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# =========================
