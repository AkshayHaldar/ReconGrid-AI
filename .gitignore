# =====================================================================
# ReconGrid-AI — Professional .gitignore
# Stack: Python (FastAPI) + Node.js (Next.js/React/Tailwind) + Docker
# =====================================================================

# =========================
#  Environment & Secrets
# =========================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.cert
*.p12

# Keep the example for onboarding
!.env.example

# =========================
#  Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
sdist/
wheels/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Ruff / Linting
.ruff_cache/

# Celery / Task queue
celerybeat-schedule
celerybeat.pid

# SQLite databases (local dev)
*.db
*.sqlite
*.sqlite3

# =========================
#  Node.js / JavaScript
# =========================
node_modules/
.pnpm-store/
.yarn/
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# =========================
#  Next.js
# =========================
.next/
out/

# =========================
#  Build Outputs
# =========================
dist/
build/
*.tsbuildinfo

# =========================
#  Logs
# =========================
*.log
logs/


# =========================
#  Docker
# =========================
docker-compose.override.yml
.docker/

# =========================
#  Testing & CI
# =========================
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
junit.xml

# =========================
#  Misc
# =========================
# Uploads & local storage
uploads/
storage/
tmp/
temp/

# Terraform / IaC
*.tfstate
*.tfstate.*
.terraform/

# Ngrok
ngrok.yml
.ngrok*

# Claude Code
.claude/

# Vercel
.vercel/

# Turbo
.turbo/

# Storybook
storybook-static/

# Debug
.debug/
