.dmypy.json
dmypy.json
.pytype/
.pyre/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Ruff & Linters
.ruff_cache/

# Celery / Task queue
celerybeat-schedule
celerybeat.pid

# SQLite Databases & WAL Journal Files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

